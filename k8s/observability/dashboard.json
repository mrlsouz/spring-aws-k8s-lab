{
  "id": null,
  "uid": "notes-lab-observability",
  "title": "Spring AWS K8s Lab",
  "tags": ["notes-lab"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {"from": "now-30m", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "API requests per second",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{"refId": "A", "expr": "sum(rate(http_server_requests_seconds_count{job=\"notes-api\"}[5m]))", "legendFormat": "requests/s"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}
    },
    {
      "id": 2,
      "title": "API 5xx responses per second",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [{"refId": "A", "expr": "sum(rate(http_server_requests_seconds_count{job=\"notes-api\",status=~\"5..\"}[5m]))", "legendFormat": "5xx/s"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}
    },
    {
      "id": 3,
      "title": "Average API latency",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [{"refId": "A", "expr": "sum(rate(http_server_requests_seconds_sum{job=\"notes-api\"}[5m])) / sum(rate(http_server_requests_seconds_count{job=\"notes-api\"}[5m]))", "legendFormat": "average"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "id": 4,
      "title": "DynamoDB Local operations per second",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [{"refId": "A", "expr": "sum by (operation, result) (rate(notes_dynamodb_operation_seconds_count{job=\"notes-api\"}[5m]))", "legendFormat": "{{operation}} · {{result}}"}],
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}
    },
    {
      "id": 5,
      "title": "Average DynamoDB Local operation duration",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [{"refId": "A", "expr": "sum by (operation) (rate(notes_dynamodb_operation_seconds_sum{job=\"notes-api\"}[5m])) / sum by (operation) (rate(notes_dynamodb_operation_seconds_count{job=\"notes-api\"}[5m]))", "legendFormat": "{{operation}}"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "id": 6,
      "title": "Available replicas by Deployment",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "targets": [{"refId": "A", "expr": "kube_deployment_status_replicas_available{namespace=\"lab\"}", "legendFormat": "{{deployment}}"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []}
    },
    {
      "id": 7,
      "title": "Pod restarts in the last 15 minutes",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 24},
      "targets": [{"refId": "A", "expr": "sum by (pod) (increase(kube_pod_container_status_restarts_total{namespace=\"lab\"}[15m]))", "legendFormat": "{{pod}}"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []}
    }
  ]
}
